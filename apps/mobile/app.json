{
  "expo": {
    "name": "sem",
    "slug": "sem-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "sem",
    "icon": "./assets/icon/icon.png",
    "android": {
      "package": "cloud.matzen.sem",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/adaptive-foreground.png",
        "backgroundImage": "./assets/icon/adaptive-background.png"
      }
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/icon/favicon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
